# Canonical production URL (set in Vercel → Project → Environment Variables)
NEXT_PUBLIC_SITE_URL=https://krisonsmarketing.com

# Web3Forms access key for the sample / quote request form (and the optional
# profile email gate). Get a free key at https://web3forms.com with the inbox
# that should receive enquiries. Without a key the form still works: it hands
# the buyer's details to a pre-filled email or WhatsApp message instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Placeholder slots (certificates, test values, portraits, video…) show in
# development and on Vercel preview deployments, and are left out of production.
# Force them on (1) or off (0) anywhere:
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=1
